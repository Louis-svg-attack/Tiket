# Sistem Manajemen Travel Umroh & Haji
# Source code by Toko Source Code — https://id.shp.ee/gteU4cYe
APP_NAME="Sistem Umroh Haji"
# Pakai "local" saat development di komputer sendiri (php artisan serve),
# "production" hanya di server sungguhan.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# WAJIB diisi sesuai alamat asli aplikasi, lengkap dengan http:// atau https://
APP_URL=http://127.0.0.1:8000

# HTTPS otomatis dipaksa bila APP_URL sudah https. Isi true/false hanya bila
# ingin menimpa perilaku otomatis tersebut (mis. SSL diterminasi di proxy).
# FORCE_HTTPS=true

# Isi bila aplikasi berada di belakang Cloudflare / nginx / load balancer,
# supaya IP asli pengunjung terbaca dan rate limit login tidak tercampur.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database — gunakan MySQL (bukan SQLite) untuk produksi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_umroh_haji
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true HANYA bila situs benar-benar diakses via https, kalau tidak cookie
# sesi akan dibuang browser dan login terus kembali ke form / error 419.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
